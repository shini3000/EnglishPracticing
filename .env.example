# Agente Python: copia este archivo a .env en la raiz.
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
# Sustituye las cinco credenciales obligatorias por valores de tus cuentas.
# Las tres variables LiveKit deben coincidir con las de web/.env.local o web/.env.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
GROQ_API_KEY=your_groq_api_key
LLM_PROVIDER=groq
# Correcciones dentro de la llamada: independiente de conversacion y evaluacion.
# groq | google | deepseek. Sin esta variable se conserva el comportamiento legado
# (el modelo de conversacion redacta sus tarjetas). Al definirla, solo se envia
# la respuesta al corrector cuando el tutor solicita una revision.
CORRECTION_PROVIDER=groq
# Opcional: modelo exclusivo del corrector; por defecto usa el *_LLM_MODEL
# del proveedor elegido (LLM_MODEL para Groq). Usa sus presupuestos *_MAX_*.
# CORRECTION_MODEL=openai/gpt-oss-20b
# Evaluacion final: groq | google | deepseek, independiente de las dos anteriores.
GRADING_PROVIDER=groq
GOOGLE_GRADING_MODEL=gemini-3-flash-preview
# DeepSeek V4.1 Flash: API de pago, requiere saldo o creditos del proveedor.
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_LLM_MODEL=deepseek-flash
# Para evaluar tambien con DeepSeek:
# GRADING_PROVIDER=deepseek
DEEPSEEK_GRADING_MODEL=deepseek-flash
DEEPSEEK_HISTORY_TURNS=48
# Presupuestos locales: NO son cuota gratis ni un limite monetario garantizado.
DEEPSEEK_TPM_BUDGET=60000
DEEPSEEK_TPD_BUDGET=300000
DEEPSEEK_RPM_BUDGET=10
DEEPSEEK_RPD_BUDGET=300
DEEPSEEK_MAX_REQUEST_TOKENS=32000
DEEPSEEK_MAX_COMPLETION_TOKENS=1024
DEEPSEEK_MAX_WAIT_SECONDS=10
# Para Gemini: LLM_PROVIDER=google; conserva Groq para STT y evaluacion opcional.
# GOOGLE_API_KEY=your_new_google_ai_studio_key
GOOGLE_LLM_MODEL=gemini-3-flash-preview
GOOGLE_HISTORY_TURNS=48
# Limites locales ilustrativos, NO cuotas garantizadas. Ajustalos en AI Studio.
GOOGLE_TPM_BUDGET=60000
GOOGLE_TPD_BUDGET=300000
GOOGLE_RPM_BUDGET=5
GOOGLE_RPD_BUDGET=20
GOOGLE_MAX_REQUEST_TOKENS=32000
GOOGLE_MAX_COMPLETION_TOKENS=2048
GOOGLE_MAX_WAIT_SECONDS=60
TAVILY_API_KEY=your_tavily_api_key

# Modelos: selecciones explicitas para no depender de defaults historicos.
LLM_MODEL=openai/gpt-oss-20b
GRADING_MODEL=openai/gpt-oss-120b
STT_MODEL=whisper-large-v3-turbo
# El idioma de reconocimiento está fijado a inglés en ambas llamadas, sin autodetección.
# El idioma nativo elegido se mantiene para las explicaciones y preguntas por escrito.
# Legado, sin uso: la voz del avatar se elige manualmente, no mediante vision.
VISION_MODEL=qwen/qwen3.8-27b

# Opcional: progreso persistente. Descomenta con una conexion real.
# Usa la misma base que DATABASE_URL del frontend.
# PROGRESS_DATABASE_URL=postgresql://user:password@your-host/database?sslmode=require

# Opcional: avatar con foto; requiere cuenta/plan/creditos compatibles.
# BITHUMAN_API_SECRET=your_bithuman_api_secret

# Presupuestos locales conservadores; no aumentan las cuotas de Groq.
GROQ_TPM_BUDGET=7200
GROQ_TPD_BUDGET=180000
GROQ_RPM_BUDGET=24
GROQ_RPD_BUDGET=900
GROQ_MAX_REQUEST_TOKENS=3600
GROQ_MAX_COMPLETION_TOKENS=640
GROQ_MAX_WAIT_SECONDS=60

# Pausas al hablar: espera aproximada desde la ultima voz detectada.
# Aumenta TURN_END_SILENCE_SECONDS a 4.0 si necesitas mas tiempo para pensar.
TURN_END_SILENCE_SECONDS=3.0
VAD_SILENCE_SECONDS=1.0

# No agregues DATABASE_URL, APP_PASSCODE ni AGENT_NAME aqui.
# Esas variables pertenecen exclusivamente al entorno del frontend.
