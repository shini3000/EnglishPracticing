# Agente Python: copia este archivo a .env en la raiz.
# Sustituye las cinco credenciales obligatorias por valores de tus cuentas.
# Las tres variables LiveKit deben coincidir con las de web/.env.local o web/.env.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
GROQ_API_KEY=your_groq_api_key
TAVILY_API_KEY=your_tavily_api_key

# Modelos: selecciones explicitas para no depender de defaults historicos.
LLM_MODEL=openai/gpt-oss-20b
GRADING_MODEL=openai/gpt-oss-120b
STT_MODEL=whisper-large-v3-turbo
VISION_MODEL=qwen/qwen3.8-27b

# Opcional: progreso persistente. Descomenta con una conexion real.
# Usa la misma base que DATABASE_URL del frontend.
# PROGRESS_DATABASE_URL=postgresql://user:password@your-host/database?sslmode=require

# Opcional: avatar con foto; requiere cuenta/plan/creditos compatibles.
# BITHUMAN_API_SECRET=your_bithuman_api_secret

# Presupuestos locales conservadores; no aumentan las cuotas de Groq.
GROQ_TPM_BUDGET=7200
GROQ_TPD_BUDGET=180000
GROQ_RPM_BUDGET=24
GROQ_RPD_BUDGET=900
GROQ_MAX_REQUEST_TOKENS=3600
GROQ_MAX_COMPLETION_TOKENS=640
GROQ_MAX_WAIT_SECONDS=60

# Pausas al hablar: espera aproximada desde la ultima voz detectada.
# Aumenta TURN_END_SILENCE_SECONDS a 4.0 si necesitas mas tiempo para pensar.
TURN_END_SILENCE_SECONDS=3.0
VAD_SILENCE_SECONDS=1.0

# No agregues DATABASE_URL, APP_PASSCODE ni AGENT_NAME aqui.
# Esas variables pertenecen exclusivamente al entorno del frontend.
