.env
.venv

# Python bytecode and tool caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/

# Private local learning evidence awaiting database recovery
.data/
logs/

# Local infrastructure notes and runtime configuration; never publish these.
.private/
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx

# Personal mobile artifacts and signing material are never versioned.
*.apk
*.aab
*.jks
*.keystore
