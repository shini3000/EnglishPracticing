# Enviroment variables needed to connect to the LiveKit server.
LIVEKIT_API_KEY=<your_api_key>
LIVEKIT_API_SECRET=<your_api_secret>
LIVEKIT_URL=wss://<project-subdomain>.livekit.cloud

# Agent dispatch (https://docs.livekit.io/agents/server/agent-dispatch)
# Leave AGENT_NAME blank to enable automatic dispatch
# Provide an agent name to enable explicit dispatch
AGENT_NAME=

# Sign-in gate: what visitors type at /login to start a call.
APP_PASSCODE=<shared_passcode>

# Second gate, for the personalized photo avatar only (metered bitHuman credits).
AVATAR_PASSCODE=<avatar_passcode>

# Progress dashboard + avatar photos. Optional: without it the tutor still works.
DATABASE_URL=<postgres_connection_string>

# Internally used environment variables
# Ejercicio sin llamada: claves privadas del servidor Next.js (NUNCA NEXT_PUBLIC_).
# Usa las mismas claves que el agente si quieres compartir saldo/cuota.
DEEPSEEK_API_KEY=
DEEPSEEK_LLM_MODEL=deepseek-flash
GROQ_API_KEY=
NEXT_PUBLIC_APP_CONFIG_ENDPOINT=
SANDBOX_ID=
