# Enviroment variables needed to connect to the LiveKit server.
LIVEKIT_API_KEY=<your_api_key>
LIVEKIT_API_SECRET=<your_api_secret>
LIVEKIT_URL=wss://<project-subdomain>.livekit.cloud

# Agent dispatch (https://docs.livekit.io/agents/server/agent-dispatch)
# Leave AGENT_NAME blank to enable automatic dispatch
# Provide an agent name to enable explicit dispatch
AGENT_NAME=

# Clerk: solo el servidor. No se requieren durante docker build.
# Publishable key no es secreta: el servidor la entrega al SDK del navegador.
CLERK_PUBLISHABLE_KEY=
# Secret key privada: nunca NEXT_PUBLIC_, nunca en la imagen o el repositorio.
CLERK_SECRET_KEY=
# Origenes del navegador, sin barra final. Agrega tu dominio al desplegar.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Second gate, for the personalized photo avatar only (metered bitHuman credits).
AVATAR_PASSCODE=<avatar_passcode>

# Obligatoria: identidad interna, progreso y fotos. Misma base que el agente.
DATABASE_URL=<postgres_connection_string>

# Internally used environment variables
# Corrector de bloques 1 y 4: groq | google | deepseek, independiente del agente.
# El default deepseek conserva las instalaciones anteriores. Para cambiarlo,
# configura el proveedor, su clave en este archivo y un modelo compatible con JSON.
CORRECTION_PROVIDER=deepseek
# Opcional: modelo exclusivo de correcciones. Si se omite: LLM_MODEL (Groq),
# GOOGLE_LLM_MODEL o DEEPSEEK_LLM_MODEL segun el proveedor elegido.
# CORRECTION_MODEL=deepseek-flash
# Presupuestos locales aproximados, no cuotas del proveedor ni topes de dinero.
# CORRECTION_MAX_REQUEST_TOKENS=32000
# CORRECTION_MAX_COMPLETION_TOKENS=1400
# Claves privadas del servidor Next.js (NUNCA NEXT_PUBLIC_).
# Usa las mismas claves que el agente si quieres compartir saldo/cuota.
DEEPSEEK_API_KEY=
DEEPSEEK_LLM_MODEL=deepseek-flash
GROQ_API_KEY=
# GOOGLE_API_KEY=
# GOOGLE_LLM_MODEL=gemini-3-flash-preview
# LLM_MODEL=openai/gpt-oss-20b
NEXT_PUBLIC_APP_CONFIG_ENDPOINT=
SANDBOX_ID=
